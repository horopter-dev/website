{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "build": "astro build && node scripts/check-build.ts dist",
    "dev": "astro dev",
    "format": "oxfmt && prettier --write \"**/*.astro\"",
    "format:check": "oxfmt --check && prettier --check \"**/*.astro\"",
    "lint": "oxlint",
    "preview": "astro preview",
    "test": "vitest run",
    "types:check": "astro sync && tsc --noEmit && astro check"
  },
  "dependencies": {
    "@fontsource/red-hat-display": "5.3.0",
    "@fontsource/red-hat-mono": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "happy-dom": "21.0.4",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "wrangler": "4.150.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
