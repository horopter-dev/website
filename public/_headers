# The half of the CSP a <meta> tag cannot carry; Astro writes the resource directives into
# every page. scripts/check-build.ts fails the build if either half is missing.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'
  Content-Security-Policy: object-src 'none'; form-action 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# The project's pages.dev hostname stays out of search; www.horopter.dev is canonical. Pages
# sends noindex on preview hostnames itself.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
