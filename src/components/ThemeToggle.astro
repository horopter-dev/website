---
// public/theme.js shows this and wires its buttons; with JavaScript off it stays hidden and the
// page follows the system setting.
---

<div
  data-theme-toggle
  hidden
  role="group"
  aria-label="Theme"
  class="flex gap-1 rounded-full border border-ink/20 p-1"
>
  <button
    type="button"
    data-theme-choice="system"
    aria-label="System theme"
    class="rounded-full p-1.5 aria-pressed:bg-ink/10"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2">
      <rect x="3" y="4" width="18" height="12" rx="2"></rect>
      <path d="M8 20h8M12 16v4"></path>
    </svg>
  </button>
  <button
    type="button"
    data-theme-choice="light"
    aria-label="Light theme"
    class="rounded-full p-1.5 aria-pressed:bg-ink/10"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M2 12h2M20 12h2"></path>
      <path d="M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
  </button>
  <button
    type="button"
    data-theme-choice="dark"
    aria-label="Dark theme"
    class="rounded-full p-1.5 aria-pressed:bg-ink/10"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2">
      <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path>
    </svg>
  </button>
</div>
