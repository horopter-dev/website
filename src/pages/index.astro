---
import Base from "#src/layouts/Base.astro";

const docs = "https://docs.horopter.dev";
const httpApi = `${docs}/reference/http-api/`;

const description =
  "Horopter is a vendor-neutral store for change events. It joins events from CI, cluster " +
  "controllers and people into changes, and serves them to Grafana, OpenTelemetry tools, " +
  "scripts and your own analysis.";

const why = [
  {
    title: "Correlated",
    text:
      "Events from different systems become one change: CI starts a deploy, the cluster " +
      "controller finishes it, and Horopter knows they are the same deploy.",
  },
  {
    title: "Yours to query",
    text:
      "Every change, and the events behind it, over an HTTP API and the horo command line, " +
      "as JSON, for scripts, reports and analysis.",
  },
  {
    title: "Any reader",
    text:
      "Grafana draws changes as regions on your graphs; OpenTelemetry tools read them as " +
      "spans; anything that speaks HTTP reads them as they are.",
  },
];

const panelAlt =
  "A Grafana graph of request rate with a shaded region marking a deploy: the rate climbs " +
  "inside the region, then falls back.";

const waysIn = [
  {
    title: "Try Horopter",
    text:
      "Run it on your machine in a few minutes: record a change, then see it on a Grafana " +
      "graph.",
    href: `${docs}/tutorials/try-horopter/`,
  },
  {
    title: "Install",
    text: "Run Horopter in Kubernetes with its Helm chart.",
    href: `${docs}/how-to/install-kubernetes/`,
  },
  {
    title: "Read the docs",
    text: "Concepts, how-to guides and the reference.",
    href: `${docs}/`,
  },
];

const worksWith = [
  {
    label: "Records from",
    links: [
      { name: "Flux", href: `${docs}/how-to/flux/` },
      { name: "GitHub Actions", href: `${docs}/how-to/github-action/` },
      { name: "horo", href: `${docs}/reference/horo/` },
      { name: "CloudEvents", href: `${httpApi}#post-v1eventscloudevents` },
    ],
  },
  {
    label: "Read by",
    links: [
      { name: "Grafana", href: `${docs}/how-to/grafana/` },
      { name: "OpenTelemetry (OTLP spans)", href: `${httpApi}#get-adaptersotlpspans` },
      { name: "the HTTP API", href: `${httpApi}#get-v1changes` },
    ],
  },
];
---

<Base title="Horopter · One record of every change, from every system" description={description}>
  <section class="py-16 sm:py-24">
    <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
      One record of every change, from every system.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/80">
      Deploys, rollouts, migrations and incidents happen in many systems, and each records them its
      own way. Horopter takes their events in one shape, joins the ones that belong together into
      changes, and serves them to whatever needs to know what changed.
    </p>
  </section>

  <section class="pb-16 sm:pb-24" aria-labelledby="why">
    <h2 id="why" class="sr-only">
      Why Horopter
    </h2>
    <dl class="grid gap-8 sm:grid-cols-3">
      {why.map(({ title, text }) => (
        <div>
          <dt class="text-lg font-semibold">{title}</dt>
          <dd class="mt-2 text-ink/80">{text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <figure>
    <div class="overflow-hidden rounded-xl border border-ink/15 shadow-sm">
      <img
        class="light-only h-auto w-full"
        src="/panel/light.webp"
        alt={panelAlt}
        width="1200"
        height="573"
        decoding="async"
      />
      <img
        class="dark-only h-auto w-full"
        src="/panel/dark.webp"
        alt={panelAlt}
        width="1200"
        height="573"
        decoding="async"
      />
    </div>
    <figcaption class="mt-3 text-sm text-ink/70">
      One reader of many: Grafana, drawing a deploy as a region on a request-rate graph.
    </figcaption>
  </figure>

  <section class="py-16 sm:py-24" aria-labelledby="ways-in">
    <h2 id="ways-in" class="sr-only">
      Get started
    </h2>
    <ul class="grid gap-4 sm:grid-cols-3">
      {waysIn.map(({ title, text, href }) => (
        <li>
          <a
            class:list={[
              "group flex h-full flex-col gap-2 rounded-xl border border-ink/15 p-6",
              "transition-colors hover:border-accent",
            ]}
            href={href}
          >
            <span class="text-lg font-semibold">
              {title}
              <span
                aria-hidden="true"
                class:list={[
                  "ml-1 inline-block text-accent",
                  "transition-transform group-hover:translate-x-0.5",
                ]}
              >
                →
              </span>
            </span>
            <span class="text-ink/80">{text}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="pb-16 sm:pb-24" aria-labelledby="works-with">
    <h2 id="works-with" class="text-2xl font-semibold tracking-tight">
      Works with
    </h2>
    <dl class="mt-6 grid gap-6 sm:grid-cols-2">
      {worksWith.map(({ label, links }) => (
        <div>
          <dt class="font-semibold">{label}</dt>
          <dd class="mt-2">
            <ul class="flex flex-wrap gap-x-5 gap-y-2">
              {links.map(({ name, href }) => (
                <li>
                  <a
                    class="underline decoration-accent underline-offset-4 hover:decoration-2"
                    href={href}
                  >
                    {name}
                  </a>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  </section>
</Base>
